   ],
   "source": [
    "\n",
    "from Heap import Heap\n",
    "from Birthday import Birthday\n",
    "\n",
    "with open(\"birthday.csv\", \"r\", encoding=\"utf-8\") as f:\n",
    "    csv_text = f.read()\n",
    "\n",
    "birthdays = Birthday.parse_csv(csv_text)\n",
    "heap = Heap(birthdays)\n",
    "heap.buildHeap()\n",
    "\n",
    "for i in range(10):\n",
    "    print(heap.deleteMax())"
   ]
